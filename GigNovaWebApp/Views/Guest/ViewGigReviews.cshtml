@using GigNovaModels.ViewModels
@model List<GigReviewViewModel>
@{
    ViewData["Title"] = "ViewGigReviews";

    // Pick the right layout based on the current session.
    Layout = "~/Views/Shared/MasterGuestPage.cshtml";
    string personId = Context.Session.GetString("person_id");
    string actor = Context.Session.GetString("actor");
    if (personId != null)
    {
        if (actor == "seller")
        {
            Layout = "~/Views/Shared/MasterSellerPage.cshtml";
        }
        else
        {
            Layout = "~/Views/Shared/MasterBuyerPage.cshtml";
        }
    }

    // Compute the average rating across all the reviews for this gig.
    string gigId = Convert.ToString(ViewData["GigId"]);
    double averageRating = 0;
    if (Model != null && Model.Count > 0)
    {
        double sum = 0;
        foreach (GigReviewViewModel review in Model)
        {
            sum += review.Review_rating;
        }
        averageRating = sum / Model.Count;
    }

    int reviewsCount = 0;
    if (Model != null)
    {
        reviewsCount = Model.Count;
    }
}
<link href="~/css/guest_pages/catalog_page.css" rel="stylesheet" />

<div class="catalog-container">
    <div class="gigs-section">
        <div class="gigs-header" style="display:flex; justify-content:space-between; align-items:flex-start; gap:12px;">
            <div>
                <h2>Gig Reviews (@reviewsCount)</h2>
                <p class="price-label review-average-text" style="margin-top:6px;">Overall average rating: @averageRating</p>
            </div>
            <button type="button" class="action-btn" style="background:#19a64b; color:white; max-width:260px; min-width:190px;" onclick="openReviewPopup()">
                Upload a gig review
            </button>
        </div>

        @if (Model != null && Model.Count > 0)
        {
            foreach (GigReviewViewModel review in Model)
            {
                <div class="gig-card review-card" style="margin-bottom:12px;">
                    <div class="gig-info">
                        <p class="gig-title review-rating-text" style="margin-bottom:6px;">Rating: @review.Review_rating / 5</p>

                        @* Clickable "By <buyer>" line. The three data-* attributes carry the buyer info
                           so the popup can read them on click without another server roundtrip. *@
                        <p style="margin-bottom:6px;">
                            <span style="color:#aeb3db;">By</span>
                            <span class="buyer-name-link"
                                  style="color:#9fb0ff; cursor:pointer; text-decoration:underline; font-weight:700;"
                                  data-display-name="@review.Buyer_display_name"
                                  data-username="@review.Person_username"
                                  data-bio="@review.Buyer_description"
                                  data-join-date="@review.Person_join_date"
                                  onclick="openBuyerInfoFromCard(this)">@review.Buyer_display_name</span>
                        </p>

                        <p class="gig-description" style="min-height:auto; margin-bottom:8px;">@review.Review_comment</p>
                        <p class="price-label">@review.Review_creation_date</p>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <h3>No reviews yet for this gig.</h3>
            </div>
        }
    </div>
</div>


<!-- ============================== Review Upload Popup (hidden by default) ============================== -->
<div id="reviewPopup" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.65); z-index:2000;">
    <div style="max-width:520px; margin:8% auto; background:#1f244e; border:1px solid #3f477f; border-radius:10px; padding:22px; color:#f2f3ff;">
        <h3 style="margin-top:0; color:#f2f3ff;">Upload Gig Review</h3>
        <label style="display:block; margin-bottom:6px; color:#d5d8ef;">Rating (1 to 5)</label>
        <select id="reviewRating" style="width:100%; margin-bottom:14px; padding:10px; background:#1d2140; color:#f2f3ff; border:1px solid #5a619b; border-radius:8px;">
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5" selected>5</option>
        </select>
        <label style="display:block; margin-bottom:6px; color:#d5d8ef;">Comment</label>
        <textarea id="reviewComment" style="width:100%; min-height:140px; padding:10px; background:#1d2140; color:#f2f3ff; border:1px solid #5a619b; border-radius:8px; resize:vertical;" placeholder="Write your review..."></textarea>
        <div style="display:flex; gap:10px; margin-top:14px;">
            <button type="button" class="action-btn" onclick="submitReview()">Submit</button>
            <button type="button" class="action-btn clear-btn" onclick="closeReviewPopup()">Cancel</button>
        </div>
    </div>
</div>


<!-- ============================== Buyer Info Popup (hidden by default) ============================== -->
<div id="buyerInfoPopup" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.65); z-index:2000;">
    <div style="max-width:480px; margin:8% auto; background:#1f244e; border:1px solid #3f477f; border-radius:10px; padding:22px; color:#f2f3ff;">
        <h3 style="margin-top:0; color:#f2f3ff;">Buyer Info</h3>

        <p style="margin:0 0 10px 0;">
            <span style="color:#aeb3db;">Display name:</span>
            <strong id="buyerInfoDisplayName" style="color:#ffffff; margin-left:6px;"></strong>
        </p>

        <p style="margin:0 0 10px 0;">
            <span style="color:#aeb3db;">Username:</span>
            <strong id="buyerInfoUsername" style="color:#ffffff; margin-left:6px;"></strong>
        </p>

        <p style="margin:0 0 10px 0;">
            <span style="color:#aeb3db;">Joined:</span>
            <strong id="buyerInfoJoinDate" style="color:#ffffff; margin-left:6px;"></strong>
        </p>

        <p style="margin:0 0 16px 0;">
            <span style="color:#aeb3db;">Bio:</span>
            <span id="buyerInfoBio" style="color:#f2f3ff; margin-left:6px; display:block; margin-top:4px; white-space:pre-wrap;"></span>
        </p>

        <div style="display:flex; gap:10px;">
            <button type="button" class="action-btn clear-btn" onclick="closeBuyerInfoPopup()">Close</button>
        </div>
    </div>
</div>


<!-- ============================== JavaScript ============================== -->
@*
    What this script does:
    - openReviewPopup / closeReviewPopup / submitReview : upload-a-review flow (unchanged)
    - openBuyerInfoFromCard : a buyer name was clicked - read the three data-* attributes
                              the Razor code wrote into the <span>, fill the popup, show it
    - closeBuyerInfoPopup   : hide the buyer info popup
*@
<script>

    // ----------- Upload Review popup -----------

    // Open the review popup. If nobody is logged in, send the user to the sign-up page instead.
    function openReviewPopup() {
        var actor = '@(actor ?? "")';
        if (actor == "") {
            window.location.href = '/Guest/SignUpPage';
            return;
        }
        document.getElementById('reviewPopup').style.display = 'block';
    }

    function closeReviewPopup() {
        document.getElementById('reviewPopup').style.display = 'none';
    }

    // Send the review to the server, show the response message, and reload the page on success.
    async function submitReview() {
        var rating = parseInt(document.getElementById('reviewRating').value);
        var comment = document.getElementById('reviewComment').value;
        var gigId = '@gigId';

        var response = await fetch('/Buyer/UploadGigReview', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
            body: new URLSearchParams({
                Review_rating: rating,
                Review_comment: comment,
                Gig_id: gigId
            })
        });

        var result = await response.json();
        showSiteAlert(result.message);
        if (result.success) {
            window.location.reload();
        }
    }


    // ----------- Buyer Info popup -----------

    // Called when the user clicks a buyer name on a review card. The card's <span>
    // carries data-display-name / data-username / data-bio attributes that Razor filled in.
    function openBuyerInfoFromCard(elem) {
        var displayName = elem.dataset.displayName;
        var username = elem.dataset.username;
        var bio = elem.dataset.bio;
        var joinDate = elem.dataset.joinDate;

        if (displayName == null || displayName == "") {
            displayName = "Unknown";
        }
        if (username == null || username == "") {
            username = "(none)";
        }
        if (bio == null || bio == "") {
            bio = "(no bio)";
        }
        if (joinDate == null || joinDate == "") {
            joinDate = "(unknown)";
        }

        document.getElementById('buyerInfoDisplayName').innerText = displayName;
        document.getElementById('buyerInfoUsername').innerText = username;
        document.getElementById('buyerInfoJoinDate').innerText = joinDate;
        document.getElementById('buyerInfoBio').innerText = bio;
        document.getElementById('buyerInfoPopup').style.display = 'block';
    }

    function closeBuyerInfoPopup() {
        document.getElementById('buyerInfoPopup').style.display = 'none';
    }
</script>
